# ==============================================================================
# Global Luxury Emporium - Environment Template
# Copy this file to .env and provide your actual credentials
# ==============================================================================

# Supabase Credentials (from Supabase Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key

# Stripe Payment Gateway (from Stripe Dashboard > Developers > API keys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# PayPal Gateway - Frontend Client ID (from PayPal Developer Dashboard > Apps & Credentials)
# IMPORTANT: Only the Client ID is exposed in the frontend. Never expose the Secret.
VITE_PAYPAL_CLIENT_ID=your_paypal_client_id

# ------------------------------------------------------------------------------
# Backend Secrets (Configured in Supabase Project Settings > Edge Functions > Secrets)
# DO NOT put PAYPAL_CLIENT_SECRET in client-facing .env or VITE_ variables!
# ------------------------------------------------------------------------------
# PAYPAL_CLIENT_ID=your_paypal_client_id
# PAYPAL_CLIENT_SECRET=your_paypal_client_secret
# PAYPAL_ENVIRONMENT=sandbox  # or 'production'

# Microsoft Clarity Session Recording & Behavior Analytics
# (from Microsoft Clarity Dashboard > Settings > Overview > Project ID)
VITE_CLARITY_PROJECT_ID=
